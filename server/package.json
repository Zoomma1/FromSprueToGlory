{
    "name": "from-sprue-to-glory-server",
    "version": "0.1.0",
    "description": "Backend API for From Sprue to Glory — Warhammer Pile of Shame tracker",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/index.js",
        "lint": "eslint src/ tests/",
        "test": "vitest run",
        "test:watch": "vitest",
        "seed": "tsx prisma/seed.ts",
        "seed:full": "tsx prisma/seed.ts --test-data",
        "migrate": "prisma migrate dev",
        "migrate:prod": "prisma migrate deploy",
        "import": "tsx scripts/import.ts",
        "migrate:dataset": "tsx scripts/migrate-dataset.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.992.0",
        "@aws-sdk/s3-request-presigner": "^3.992.0",
        "@prisma/client": "^6.4.1",
        "bcryptjs": "^2.4.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "express-rate-limit": "^7.5.0",
        "helmet": "^8.0.0",
        "jsonwebtoken": "^9.0.2",
        "passport": "^0.7.0",
        "passport-google-oauth20": "^2.0.0",
        "resend": "^6.10.0",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "zod": "^3.24.2"
    },
    "overrides": {
        "fast-xml-parser": ">=5.5.6"
    },
    "devDependencies": {
        "@eslint/js": "^9.20.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/jsonwebtoken": "^9.0.9",
        "@types/node": "^22.13.4",
        "@types/passport": "^1.0.17",
        "@types/passport-google-oauth20": "^2.0.17",
        "@types/supertest": "^6.0.3",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.7",
        "eslint": "^9.20.0",
        "prettier": "^3.5.1",
        "prisma": "^6.4.1",
        "supertest": "^7.2.2",
        "tsx": "^4.19.2",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.24.0",
        "vitest": "^3.2.6"
    }
}
